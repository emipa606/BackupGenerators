<Solution>
  <Configurations>
    <BuildType Name="Release" />
  </Configurations>
  <Project Path="BackupGenerators/BackupGenerators.csproj" />
  <Properties Name="MonoDevelopProperties">
    <Property Name="$0.DotNetNamingPolicy" Value="$1" />
    <Property Name="$0.StandardHeader" Value="$2" />
    <Property Name="$0.VersionControlPolicy" Value="$3" />
    <Property Name="$1.DirectoryNamespaceAssociation" Value="PrefixedHierarchical" />
    <Property Name="outputpath" Value="../1.1/Assemblies" />
    <Property Name="Policies" Value="$0" />
  </Properties>
  <Folder Name="/.github/">
    <File Path="../.github/copilot-instructions.md" />
  </Folder>
  <Folder Name="/XML/Languages/English/Keyed/">
    <File Path="../Languages/English/Keyed/ModSettings.xml" />
  </Folder>
  <Folder Name="/XML/1.6/Patches/">
    <File Path="../1.6/Patches/owlchemist.simplefxsmoke.xml" />
  </Folder>
  <Folder Name="/XML/About/">
    <File Path="../About/about.xml" />
  </Folder>
  <Folder Name="/XML/1.6/Defs/">
    <File Path="../1.6/Defs/BackupGenerator.xml" />
  </Folder>
</Solution>